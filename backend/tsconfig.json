{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["src/*"] }
  },
  // Only src/ — adding prisma/ here widens rootDir and nest build would emit
  // dist/src/main.js instead of dist/main.js. ts-node compiles prisma/seed.ts fine.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
