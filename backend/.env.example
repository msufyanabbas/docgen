# --- Server ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://docgen:docgen@localhost:5432/tawal_docgen?schema=public"

# --- Storage ---
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25

# Import prisma/upl-reference.xlsx automatically when the price list is empty.
AUTO_SEED_UPL=true

# --- Company defaults (pre-filled on every package) ---
DEFAULT_CONTRACTOR_NAME="SMART LIFE"
DEFAULT_PROJECT_NAME="SMART TOWER"
DEFAULT_CURRENCY=SAR

# --- Puppeteer ---
# Leave blank to use the Chromium that `npm i puppeteer` downloads.
# In Docker/Alpine set it to the system chromium, e.g. /usr/bin/chromium
PUPPETEER_EXECUTABLE_PATH=

# --- Authentication ---
# Generate a real one:  openssl rand -hex 32
# The API refuses to start in production without this set.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# First-run admin. Created only when the user table is empty, and flagged to
# force a password change at first sign-in.
ADMIN_EMAIL=admin@smart-life.sa
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# --- MOP ---
# LibreOffice converts the filled .docx to PDF.
SOFFICE_PATH=/usr/bin/soffice
