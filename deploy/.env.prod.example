# Server-side environment. scripts/deploy.sh copies this to <DEPLOY_DIR>/.env on
# the first release and fills in a generated database password. Edit it on the
# server afterwards; later deploys never overwrite it.

# --- database ---
DB_USER=docgen
DB_PASSWORD=__DB_PASSWORD__
DB_NAME=tawal_docgen

# --- public address ---
# Used for CORS. Must match how people actually reach the app.
PUBLIC_URL=https://docgen.smart-life.sa

# --- app defaults, pre-filled on every package ---
DEFAULT_CONTRACTOR_NAME=SMART LIFE
DEFAULT_PROJECT_NAME=SMART TOWER
DEFAULT_CURRENCY=SAR

# Import the bundled UPL when the price list is empty.
AUTO_SEED_UPL=true

# --- set by the deploy script ---
HOST_HTTP_PORT=8090
IMAGE_PREFIX=tawal-docgen
