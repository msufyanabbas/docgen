# Host nginx vhost for Tawal DocGen.
# Installed by scripts/server-setup.sh; certbot rewrites it to add TLS.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Generated documents can be several MB, and GCL/scope uploads up to 25MB.
    client_max_body_size 30m;

    # PDF generation runs Chromium; a five-document bundle can take a while.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    access_log /var/log/nginx/tawal-docgen.access.log;
    error_log  /var/log/nginx/tawal-docgen.error.log;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }
}
